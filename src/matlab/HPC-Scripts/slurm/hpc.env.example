# HPC settings for the Slurm jobs: TEMPLATE
#
# How to use:
#   1. Copy this file to hpc.env in the same folder:
#          cp hpc.env.example hpc.env
#   2. Fill in hpc.env with your own values.
#   3. Keep it private:  chmod 600 hpc.env
#
# hpc.env is listed in .gitignore, so your account names and e-mail are never
# committed. Only this template (hpc.env.example) is in the repository. If you
# add a new setting, add it here too, with a placeholder value.
#
# submit_hpc_scenarios.sh reads ("sources") hpc.env before it submits
# anything, and the Slurm jobs read it again when they start.
# Format: NAME="value", with no spaces around the = sign.

# ---- Required -------------------------------------------------------------

# Slurm account to charge. To list your accounts, run on the cluster:
#     sacctmgr show assoc user=$USER format=account%30
# On Tempest, the priority partition uses priority-<group> accounts. The
# nextgen and unsafe partitions use group-<group> accounts.
ADRC_SLURM_ACCOUNT="<your_account>"

# Partition (queue):
#   priority   14-day limit
#   nextgen    3-day limit
#   unsafe     7-day limit, jobs can be preempted (stopped early)
ADRC_SLURM_PARTITION="<your_partition>"

# Time limit for EACH scenario task, as days-hours:minutes:seconds.
# Must be longer than your longest scenario. preview_hpc_scenarios (in
# MATLAB) prints an estimate.
ADRC_SLURM_TIME="3-00:00:00"

# Memory for EACH scenario task. 16G is plenty for runs of a few seconds of
# motor time; raise it if a task fails with OUT_OF_MEMORY.
ADRC_SLURM_MEMORY="16G"

# MATLAB module to load (R2026a or newer). To list them, run on the cluster:
#     module avail matlab
ADRC_MATLAB_MODULE="<matlab_module_name>"

# ---- Optional (leave empty "" to skip) ------------------------------------

# CPU cores for each scenario task
ADRC_SLURM_CPUS_PER_TASK="2"

# Run at most this many scenarios at the same time (for example "5"), to
# save MATLAB licenses or stay within your group's CPU allocation.
# Empty = no limit.
ADRC_SLURM_MAX_SIMULTANEOUS_TASKS=""

# E-mail notifications. ADRC_SLURM_MAIL_TYPE can be, for example, END,FAIL
ADRC_SLURM_MAIL_USER=""
ADRC_SLURM_MAIL_TYPE="END,FAIL"
